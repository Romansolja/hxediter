<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Hardened-runtime entitlements for the Developer ID + notarization flow.
    Unused under the current ad-hoc signing path — see release.sh for activation steps.

    Minimum set for an unsandboxed hex editor under hardened runtime:
      - user-selected.read-write: rb+ fopen on NSOpenPanel paths would EPERM without this.
      - disable-library-validation: keeps third-party plug-in dlopen open as a future option.

    Sandboxing (app-sandbox) intentionally NOT enabled — would break CLI-arg and drag-drop paths.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
